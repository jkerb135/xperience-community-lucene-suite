{
  "name": "xperience-community-lucene-suite-admin",
  "version": "0.1.0",
  "description": "Admin client module of XperienceCommunity.Lucene.Suite: the per-index Search tuning templates.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode=production",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@kentico/xperience-admin-base": "31.9.1",
    "@kentico/xperience-admin-components": "31.9.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@kentico/xperience-webpack-config": "31.9.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "babel-loader": "10.1.1",
    "typescript": "5.9.3",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2",
    "webpack-dev-server": "6.0.0"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react"
  },
  "browserslist": [
    "> .2% and last 3 versions",
    "not op_mini all",
    "not IE 11"
  ]
